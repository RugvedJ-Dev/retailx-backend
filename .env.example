# ---- Runtime -------------------------------------------------------------
ENV=development                      # development | production | test
CORS_ORIGINS=http://localhost:3000   # comma separated
TIMEZONE=Asia/Kolkata                # used to resolve "today" for the planner

# ---- MongoDB (users, threads, messages, approvals, sales, LangGraph checkpoints)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=retailx

# ---- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-api-session-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=720

# ---- MCP server (separate process / deployment) --------------------------
MCP_URL=http://localhost:8001/mcp
# Shared HS256 secret used to mint/verify short-lived per-user MCP tokens.
# MUST differ from JWT_SECRET. Set the same value on the MCP server.
MCP_JWT_SECRET=change-me-mcp-secret-at-least-32-characters
MCP_TOKEN_TTL_SECONDS=300
MCP_TIMEOUT_SECONDS=15

# ---- LLM (tiered) --------------------------------------------------------
LLM_PROVIDER=groq
FAST_MODEL=llama-3.1-8b-instant      # planner + light synthesis
STRONG_MODEL=llama-3.3-70b-versatile # complex final synthesis
GROQ_API_KEY=

# ---- Agent policy --------------------------------------------------------
APPROVAL_POLICY=all_writes           # all_writes | destructive_only
APPROVAL_TTL_HOURS=24
MAX_PLAN_STEPS=5
READ_CACHE_TTL_SECONDS=60
